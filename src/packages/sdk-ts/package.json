{
  "name": "@ohmyhost/sdk-ts",
  "version": "0.1.31",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm --dir ../.. sdk-ts:check",
